{
	"name": "n8n-nodes-hypotize",
	"version": "0.1.1",
	"description": "n8n nodes for Hypotize, the agent-native Growth OS: read and write growth experiments, ideas and learnings, and trigger workflows when they change.",
	"license": "MIT",
	"publishConfig": {
		"access": "public"
	},
	"homepage": "https://hypotize.ai/developers?utm_source=npm&utm_medium=integration",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"hypotize",
		"growth",
		"experiments",
		"ab-testing",
		"growth-os"
	],
	"author": {
		"name": "Hypotize",
		"email": "hello@hypotize.ai"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/hypotizeai/n8n-nodes-hypotize.git"
	},
	"bugs": {
		"url": "https://github.com/hypotizeai/n8n-nodes-hypotize/issues"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/HypotizeApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Hypotize/Hypotize.node.js",
			"dist/nodes/HypotizeTrigger/HypotizeTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "0.55.5",
		"eslint": "9.32.0",
		"prettier": "3.6.2",
		"release-it": "^21.1.0",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
